{
  "name": "gentle-retry",
  "version": "0.2.2",
  "description": "Reliable retry for transient provider failures in Gentle Shell, Pi Coding Agent, and OpenCode 2",
  "type": "module",
  "bin": {
    "gentle-retry": "./bin/gentle-retry.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js",
      "default": "./dist/opencode.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check && pnpm test",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "gentle-shell",
    "pi-coding-agent",
    "pi-package",
    "extension",
    "opencode",
    "retry",
    "429",
    "timeout",
    "rate-limit",
    "backoff"
  ],
  "author": "Andrik <andrik.sc02@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/andrikonbeat/gentle-retry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrikonbeat/gentle-retry.git"
  },
  "bugs": {
    "url": "https://github.com/andrikonbeat/gentle-retry/issues"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "packageManager": "pnpm@11.26.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  }
}
